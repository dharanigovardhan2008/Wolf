generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id           String   @id
  userId       String
  label        String?
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])
}

model BulkOrder {
  id                     String          @id
  orderNumber            String          @unique
  status                 BulkOrderStatus @default(NEW)
  name                   String
  organization           String
  college                String?
  eventName              String?
  email                  String
  phone                  String
  quantity               Int
  tshirtType             String
  fabricPreference       String?
  colors                 String
  sizeDistribution       Json?
  frontDesignUrl         String?
  backDesignUrl          String?
  designDescription      String?
  deliveryDate           DateTime?
  deliveryAddress        String?
  budgetRange            String?
  additionalRequirements String?
  quotationAmount        Decimal?        @db.Decimal(10, 2)
  adminNotes             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime
}

model Cart {
  id        String     @id
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
}

model CartItem {
  id              String         @id
  cartId          String
  productId       String
  variantId       String
  customizationId String?
  quantity        Int            @default(1)
  priceSnapshot   Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Customization   Customization? @relation(fields: [customizationId], references: [id])
  ProductVariant  ProductVariant @relation(fields: [variantId], references: [id])
}

model Color {
  id             String           @id
  name           String           @unique
  hexCode        String
  sortOrder      Int              @default(0)
  ProductVariant ProductVariant[]
}

model Customization {
  id              String      @id
  productId       String
  frontData       Json
  backData        Json
  frontPreviewUrl String?
  backPreviewUrl  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  CartItem        CartItem[]
  Product         Product     @relation(fields: [productId], references: [id])
  OrderItem       OrderItem[]
}

model Fabric {
  id          String    @id
  name        String    @unique
  description String?
  composition String?
  Product     Product[]
}

model Order {
  id                 String               @id
  orderNumber        String               @unique
  userId             String
  status             OrderStatus          @default(NEW)
  paymentStatus      PaymentStatus        @default(PENDING)
  shippingName       String
  shippingEmail      String
  shippingPhone      String
  shippingAddress    String
  shippingCity       String
  shippingState      String
  shippingPincode    String
  shippingCountry    String               @default("India")
  gstNumber          String?
  companyName        String?
  notes              String?
  subtotal           Decimal              @db.Decimal(10, 2)
  discount           Decimal              @default(0) @db.Decimal(10, 2)
  shippingCost       Decimal              @default(0) @db.Decimal(10, 2)
  tax                Decimal              @default(0) @db.Decimal(10, 2)
  total              Decimal              @db.Decimal(10, 2)
  couponId           String?
  paymentGateway     String?
  paymentOrderId     String?
  paymentId          String?
  paymentSignature   String?
  trackingNumber     String?
  trackingUrl        String?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  User               User                 @relation(fields: [userId], references: [id])
  OrderItem          OrderItem[]
  OrderStatusHistory OrderStatusHistory[]
}

model OrderItem {
  id                String         @id
  orderId           String
  productId         String
  variantId         String
  customizationId   String?
  productName       String
  productSlug       String
  sku               String
  colorName         String
  colorHex          String
  sizeName          String
  fabricName        String
  quantity          Int
  unitPrice         Decimal        @db.Decimal(10, 2)
  totalPrice        Decimal        @db.Decimal(10, 2)
  isCustomized      Boolean        @default(false)
  customizationData Json?
  frontPreviewUrl   String?
  backPreviewUrl    String?
  Customization     Customization? @relation(fields: [customizationId], references: [id])
  Order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product           Product        @relation(fields: [productId], references: [id])
  ProductVariant    ProductVariant @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id        String      @id
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
  Order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String           @id
  name               String
  slug               String           @unique
  description        String?
  shortDescription   String?
  category           String
  productType        String
  basePrice          Decimal          @db.Decimal(10, 2)
  customizationPrice Decimal          @default(0) @db.Decimal(10, 2)
  fabricId           String?
  gsm                Int?
  isCustomizable     Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  status             ProductStatus    @default(DRAFT)
  model3dUrl         String?
  printAreaConfig    Json?
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Customization      Customization[]
  OrderItem          OrderItem[]
  Fabric             Fabric?          @relation(fields: [fabricId], references: [id])
  ProductImage       ProductImage[]
  ProductVariant     ProductVariant[]
  SavedDesign        SavedDesign[]
  WishlistItem       WishlistItem[]
}

model ProductImage {
  id        String  @id
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                String      @id
  productId         String
  sku               String      @unique
  colorId           String
  sizeId            String
  priceAdjustment   Decimal     @default(0) @db.Decimal(10, 2)
  stock             Int         @default(0)
  reservedStock     Int         @default(0)
  lowStockThreshold Int         @default(5)
  isAvailable       Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime
  CartItem          CartItem[]
  OrderItem         OrderItem[]
  Color             Color       @relation(fields: [colorId], references: [id])
  Product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  Size              Size        @relation(fields: [sizeId], references: [id])
}

model SavedDesign {
  id                String   @id
  userId            String
  name              String   @default("Untitled Design")
  productId         String
  customizationData Json
  frontPreviewUrl   String?
  backPreviewUrl    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  Product           Product  @relation(fields: [productId], references: [id])
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Size {
  id             String           @id
  name           String           @unique
  sortOrder      Int              @default(0)
  ProductVariant ProductVariant[]
}

model StoreSettings {
  id                      String   @id @default("default")
  brandName               String   @default("Wolf Theory")
  logoUrl                 String?
  contactEmail            String?
  contactPhone            String?
  businessAddress         String?
  currency                String   @default("INR")
  currencySymbol          String   @default("₹")
  frontPrintFee           Decimal  @default(0) @db.Decimal(10, 2)
  backPrintFee            Decimal  @default(0) @db.Decimal(10, 2)
  defaultCustomizationFee Decimal  @default(0) @db.Decimal(10, 2)
  flatShippingRate        Decimal? @db.Decimal(10, 2)
  freeShippingThreshold   Decimal? @db.Decimal(10, 2)
  gstRate                 Decimal? @db.Decimal(5, 2)
  instagramUrl            String?
  youtubeUrl              String?
  twitterUrl              String?
  returnPolicy            String?
  shippingPolicy          String?
  privacyPolicy           String?
  termsConditions         String?
  printDpi                Int?
  printTechnology         String?
  updatedAt               DateTime
}

model User {
  id           String        @id
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  role         Role          @default(CUSTOMER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Address      Address[]
  AuditLog     AuditLog[]
  Cart         Cart?
  Order        Order[]
  SavedDesign  SavedDesign[]
  Wishlist     Wishlist?
}

model Wishlist {
  id           String         @id
  userId       String         @unique
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  WishlistItem WishlistItem[]
}

model WishlistItem {
  id         String   @id
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())
  Product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  Wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model addresses {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  label         String?
  name          String
  phone         String
  address_line1 String
  address_line2 String?
  city          String
  state         String
  pincode       String
  country       String   @default("India")
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_users_id_fk")

  @@index([user_id])
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  old_value   Json?    @db.Json
  new_value   Json?    @db.Json
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_logs_user_id_users_id_fk")

  @@index([created_at])
  @@index([entity_type])
  @@index([user_id])
}

model bulk_orders {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number            String            @unique(map: "bulk_orders_number_idx")
  status                  bulk_order_status @default(NEW)
  name                    String
  organization            String
  college                 String?
  event_name              String?
  email                   String
  phone                   String
  quantity                Int
  tshirt_type             String
  fabric_preference       String?
  colors                  String
  size_distribution       Json?             @db.Json
  front_design_url        String?
  back_design_url         String?
  design_description      String?
  delivery_date           DateTime?         @db.Timestamp(6)
  delivery_address        String?
  budget_range            String?
  additional_requirements String?
  quotation_amount        Decimal?          @db.Decimal(10, 2)
  admin_notes             String?
  created_at              DateTime          @default(now()) @db.Timestamp(6)
  updated_at              DateTime          @default(now()) @db.Timestamp(6)

  @@index([status])
}

model cart_items {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id          String           @db.Uuid
  product_id       String           @db.Uuid
  variant_id       String           @db.Uuid
  quantity         Int              @default(1)
  customization_id String?          @db.Uuid
  price_snapshot   Decimal          @db.Decimal(10, 2)
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  updated_at       DateTime         @default(now()) @db.Timestamp(6)
  carts            carts            @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_cart_id_carts_id_fk")
  customizations   customizations?  @relation(fields: [customization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_customization_id_customizations_id_fk")
  products         products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_product_id_products_id_fk")
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_variant_id_product_variants_id_fk")

  @@index([cart_id])
}

model carts {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?      @db.Uuid
  session_id String?
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
  users      users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_user_id_users_id_fk")

  @@index([session_id])
  @@index([user_id])
}

model colors {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  hex_code         String
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  product_variants product_variants[]
}

model coupons {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String      @unique(map: "coupons_code_idx")
  type            coupon_type
  value           Decimal     @db.Decimal(10, 2)
  min_order_value Decimal?    @db.Decimal(10, 2)
  max_discount    Decimal?    @db.Decimal(10, 2)
  usage_limit     Int?
  used_count      Int         @default(0)
  valid_from      DateTime    @db.Timestamp(6)
  valid_until     DateTime    @db.Timestamp(6)
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now()) @db.Timestamp(6)
  orders          orders[]
}

model customizations {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?           @db.Uuid
  product_id        String            @db.Uuid
  variant_id        String?           @db.Uuid
  color             String
  size              String
  fabric            String?
  front_elements    Json?             @db.Json
  front_preview_url String?
  back_elements     Json?             @db.Json
  back_preview_url  String?
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @db.Timestamp(6)
  cart_items        cart_items[]
  products          products          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customizations_product_id_products_id_fk")
  users             users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customizations_user_id_users_id_fk")
  product_variants  product_variants? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customizations_variant_id_product_variants_id_fk")
}

model fabrics {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String
  composition String?
  gsm         Int?
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  products    products[]
}

model order_items {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id             String            @db.Uuid
  product_id           String?           @db.Uuid
  variant_id           String?           @db.Uuid
  product_name         String
  product_slug         String
  sku                  String
  color_name           String
  color_hex            String
  size_name            String
  fabric_name          String?
  quantity             Int
  unit_price           Decimal           @db.Decimal(10, 2)
  total_price          Decimal           @db.Decimal(10, 2)
  is_customized        Boolean           @default(false)
  customization_data   Json?             @db.Json
  front_preview_url    String?
  back_preview_url     String?
  front_print_file_url String?
  back_print_file_url  String?
  orders               orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_orders_id_fk")
  products             products?         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_product_id_products_id_fk")
  product_variants     product_variants? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_variant_id_product_variants_id_fk")

  @@index([order_id])
}

model order_status_history {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String       @db.Uuid
  status     order_status
  note       String?
  updated_by String?      @db.Uuid
  created_at DateTime     @default(now()) @db.Timestamp(6)
  orders     orders       @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_status_history_order_id_orders_id_fk")
  users      users?       @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_status_history_updated_by_users_id_fk")

  @@index([order_id])
}

model orders {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number         String                 @unique(map: "orders_number_idx")
  user_id              String?                @db.Uuid
  status               order_status           @default(NEW)
  payment_status       payment_status         @default(PENDING)
  shipping_name        String
  shipping_email       String
  shipping_phone       String
  shipping_address     String
  shipping_city        String
  shipping_state       String
  shipping_pincode     String
  shipping_country     String                 @default("India")
  gst_number           String?
  company_name         String?
  notes                String?
  subtotal             Decimal                @db.Decimal(10, 2)
  discount             Decimal                @default(0) @db.Decimal(10, 2)
  shipping_cost        Decimal                @default(0) @db.Decimal(10, 2)
  tax                  Decimal                @default(0) @db.Decimal(10, 2)
  total                Decimal                @db.Decimal(10, 2)
  coupon_id            String?                @db.Uuid
  payment_gateway      String?                @default("razorpay")
  payment_order_id     String?
  payment_id           String?
  payment_signature    String?
  tracking_number      String?
  tracking_url         String?
  shipped_at           DateTime?              @db.Timestamp(6)
  delivered_at         DateTime?              @db.Timestamp(6)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  order_items          order_items[]
  order_status_history order_status_history[]
  coupons              coupons?               @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_coupon_id_coupons_id_fk")
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_user_id_users_id_fk")

  @@index([created_at])
  @@index([status])
  @@index([user_id])
}

model product_images {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  url        String
  alt        String
  sort_order Int      @default(0)
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_products_id_fk")

  @@index([product_id], map: "images_product_id_idx")
}

model product_variants {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String           @db.Uuid
  sku                 String           @unique(map: "variants_sku_idx")
  color_id            String           @db.Uuid
  size_id             String           @db.Uuid
  price_adjustment    Decimal          @default(0) @db.Decimal(10, 2)
  stock               Int              @default(0)
  reserved_stock      Int              @default(0)
  low_stock_threshold Int              @default(5)
  is_available        Boolean          @default(true)
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  updated_at          DateTime         @default(now()) @db.Timestamp(6)
  cart_items          cart_items[]
  customizations      customizations[]
  order_items         order_items[]
  colors              colors           @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_variants_color_id_colors_id_fk")
  products            products         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_product_id_products_id_fk")
  sizes               sizes            @relation(fields: [size_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_variants_size_id_sizes_id_fk")

  @@index([product_id], map: "variants_product_id_idx")
}

model products {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String             @unique(map: "products_slug_idx")
  description         String
  short_description   String
  category            String
  product_type        String
  base_price          Decimal            @db.Decimal(10, 2)
  customization_price Decimal            @default(0) @db.Decimal(10, 2)
  fabric_id           String?            @db.Uuid
  gsm                 Int?
  is_customizable     Boolean            @default(true)
  is_featured         Boolean            @default(false)
  status              product_status     @default(DRAFT)
  model_3d_url        String?
  print_area_config   Json?              @db.Json
  seo_title           String?
  seo_description     String?
  is_archived         Boolean            @default(false)
  created_at          DateTime           @default(now()) @db.Timestamp(6)
  updated_at          DateTime           @default(now()) @db.Timestamp(6)
  cart_items          cart_items[]
  customizations      customizations[]
  order_items         order_items[]
  product_images      product_images[]
  product_variants    product_variants[]
  fabrics             fabrics?           @relation(fields: [fabric_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_fabric_id_fabrics_id_fk")
  saved_designs       saved_designs[]
  wishlist_items      wishlist_items[]

  @@index([is_featured], map: "products_featured_idx")
  @@index([status])
}

model saved_designs {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  name               String   @default("Untitled Design")
  product_id         String   @db.Uuid
  customization_data Json     @db.Json
  front_preview_url  String?
  back_preview_url   String?
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
  products           products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "saved_designs_product_id_products_id_fk")
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "saved_designs_user_id_users_id_fk")

  @@index([user_id])
}

model sizes {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  product_variants product_variants[]
}

model store_settings {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_name                String   @default("Wolf Theory")
  logo_url                  String?
  contact_email             String?
  contact_phone             String?
  business_address          String?
  currency                  String   @default("INR")
  currency_symbol           String   @default("₹")
  front_print_fee           Decimal  @default(0) @db.Decimal(10, 2)
  back_print_fee            Decimal  @default(0) @db.Decimal(10, 2)
  default_customization_fee Decimal  @default(0) @db.Decimal(10, 2)
  flat_shipping_rate        Decimal? @db.Decimal(10, 2)
  free_shipping_threshold   Decimal? @db.Decimal(10, 2)
  gst_rate                  Decimal? @db.Decimal(5, 2)
  instagram_url             String?
  youtube_url               String?
  twitter_url               String?
  return_policy             String?
  shipping_policy           String?
  privacy_policy            String?
  terms_conditions          String?
  about_content             String?
  print_dpi                 Int?     @default(300)
  print_technology          String?
  created_at                DateTime @default(now()) @db.Timestamp(6)
  updated_at                DateTime @default(now()) @db.Timestamp(6)
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                 @unique(map: "users_email_idx")
  password_hash        String
  name                 String
  phone                String?
  role                 user_role              @default(CUSTOMER)
  is_active            Boolean                @default(true)
  email_verified       DateTime?              @db.Timestamp(6)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  addresses            addresses[]
  audit_logs           audit_logs[]
  carts                carts[]
  customizations       customizations[]
  order_status_history order_status_history[]
  orders               orders[]
  saved_designs        saved_designs[]
  wishlists            wishlists?
}

model wishlist_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlist_id String    @db.Uuid
  product_id  String    @db.Uuid
  added_at    DateTime  @default(now()) @db.Timestamp(6)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_product_id_products_id_fk")
  wishlists   wishlists @relation(fields: [wishlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_wishlist_id_wishlists_id_fk")

  @@index([wishlist_id])
}

model wishlists {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @unique(map: "wishlists_user_id_idx") @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  wishlist_items wishlist_items[]
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlists_user_id_users_id_fk")
}

